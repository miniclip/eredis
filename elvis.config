[
    {config, [
        #{ files => ["src/**/*.erl"],
           ruleset => erl_files,
           rules => [{elvis_style, dont_repeat_yourself, disable},
                     {elvis_style, no_invalid_dynamic_calls, disable},
                     {elvis_style, no_if_expression, disable},
                     %% eredis_sub:receiver/1 blocks on purpose
                     {elvis_style, no_receive_without_timeout, #{ignore => [eredis_sub]}}] },
        #{ files => ["test/**/*.erl"],
           ruleset => erl_files_test,
           rules => [{elvis_text_style, max_line_length, disable},
                     {elvis_style, no_receive_without_timeout, disable}] },
        #{ files => ["rebar.config"],
           ruleset => rebar_config }
    ]},
    {verbose, true}
].
